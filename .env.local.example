NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-AQUI
ANTHROPIC_API_KEY=SUA-CHAVE-DA-ANTHROPIC-AQUI

# Domínio oficial do app, sem barra no final.
# Usado para montar links de convite e o retorno do login com Google.
# Sem isso, links gerados a partir de URLs de preview da Vercel não funcionam.
NEXT_PUBLIC_APP_URL=https://appfinancasbr.vercel.app

# Chave de integração servidor-servidor (rotas app/api/auth/*).
# Gere um valor forte: openssl rand -hex 32
# NUNCA exponha ao client nem comite o valor real.
SUPABASE_SERVICE_ROLE_KEY=SUA-SERVICE-ROLE-KEY-AQUI
INTEGRACAO_SECRET=GERE-UM-VALOR-FORTE-AQUI
